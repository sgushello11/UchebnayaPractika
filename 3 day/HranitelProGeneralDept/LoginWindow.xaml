<Window x:Class="HranitelProGeneralDept.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Терминал отдела - Вход" Height="250" Width="350"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <StackPanel Margin="20" VerticalAlignment="Center">
        <TextBlock Text="Код сотрудника:" Margin="0,5"/>
        <PasswordBox x:Name="txtCode" Margin="0,5" Height="30" FontSize="14"/>

        <TextBlock x:Name="lblError" Foreground="Red" Margin="0,10" TextAlignment="Center"/>

        <Button x:Name="btnLogin" Content="Войти" Height="35" Margin="0,5" Background="DarkGreen" Foreground="White"/>
    </StackPanel>
</Window>