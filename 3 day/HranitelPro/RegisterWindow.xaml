<Window x:Class="HranitelPro.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация" Height="550" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Фамилия*:" Margin="0,5"/>
            <TextBox x:Name="txtLastName" Margin="0,5" Height="30"/>

            <TextBlock Text="Имя*:" Margin="0,5"/>
            <TextBox x:Name="txtFirstName" Margin="0,5" Height="30"/>

            <TextBlock Text="Отчество:" Margin="0,5"/>
            <TextBox x:Name="txtPatronymic" Margin="0,5" Height="30"/>

            <TextBlock Text="Телефон:" Margin="0,5"/>
            <TextBox x:Name="txtPhone" Margin="0,5" Height="30"/>

            <TextBlock Text="Email*:" Margin="0,5"/>
            <TextBox x:Name="txtEmail" Margin="0,5" Height="30"/>

            <TextBlock Text="Дата рождения*:" Margin="0,5"/>
            <DatePicker x:Name="dpBirthDate" SelectedDate="2000-01-01" Margin="0,5"/>

            <TextBlock Text="Серия паспорта* (4 цифры):" Margin="0,5"/>
            <TextBox x:Name="txtPassportSeries" MaxLength="4" Margin="0,5" Height="30"/>

            <TextBlock Text="Номер паспорта* (6 цифр):" Margin="0,5"/>
            <TextBox x:Name="txtPassportNumber" MaxLength="6" Margin="0,5" Height="30"/>

            <TextBlock Text="Логин*:" Margin="0,5"/>
            <TextBox x:Name="txtLogin" Margin="0,5" Height="30"/>

            <TextBlock Text="Пароль*:" Margin="0,5"/>
            <PasswordBox x:Name="txtPassword" Margin="0,5" Height="30"/>

            <TextBlock Text="Подтверждение пароля*:" Margin="0,5"/>
            <PasswordBox x:Name="txtConfirmPassword" Margin="0,5" Height="30"/>

            <TextBlock x:Name="lblError" Foreground="Red" Margin="0,10" TextAlignment="Center"/>

            <Button x:Name="btnRegister" Content="Зарегистрироваться" Height="35" Margin="0,5" Background="DarkGreen" Foreground="White"/>
            <Button x:Name="btnBack" Content="Назад" Height="35" Margin="0,5"/>
        </StackPanel>
    </ScrollViewer>
</Window>