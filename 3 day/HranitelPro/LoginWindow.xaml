<Window x:Class="HranitelPro.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в систему" Height="346" Width="350"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <StackPanel Margin="20" VerticalAlignment="Center">
        <TextBlock Text="Логин:" Margin="0,5"/>
        <TextBox x:Name="txtLogin" Margin="0,5" Height="30"/>

        <TextBlock Text="Пароль:" Margin="0,10,0,5"/>
        <PasswordBox x:Name="txtPassword" Margin="0,5" Height="30"/>

        <TextBlock x:Name="lblError" Foreground="Red" Margin="0,10" TextAlignment="Center"/>

        <Button x:Name="btnLogin" Content="Войти" Height="35" Margin="0,5" Background="DarkGreen" Foreground="White"/>
        <Button x:Name="btnRegister" Content="Регистрация" Height="35" Margin="0,5"/>
    </StackPanel>
</Window>