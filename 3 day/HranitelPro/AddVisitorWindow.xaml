<Window x:Class="HranitelPro.AddVisitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление посетителя" Height="500" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Фамилия*:" FontWeight="Bold" Margin="0,5"/>
            <TextBox x:Name="txtLastName" Margin="0,5" Height="30"/>

            <TextBlock Text="Имя*:" FontWeight="Bold" Margin="0,5"/>
            <TextBox x:Name="txtFirstName" Margin="0,5" Height="30"/>

            <TextBlock Text="Отчество:" Margin="0,5"/>
            <TextBox x:Name="txtPatronymic" Margin="0,5" Height="30"/>

            <TextBlock Text="Телефон:" Margin="0,5"/>
            <TextBox x:Name="txtPhone" Margin="0,5" Height="30"/>

            <TextBlock Text="Email:" Margin="0,5"/>
            <TextBox x:Name="txtEmail" Margin="0,5" Height="30"/>

            <TextBlock Text="Дата рождения:" Margin="0,5"/>
            <DatePicker x:Name="dpBirthDate" Margin="0,5" SelectedDate="2000-01-01"/>

            <TextBlock Text="Серия паспорта:" Margin="0,5"/>
            <TextBox x:Name="txtPassportSeries" MaxLength="4" Margin="0,5" Height="30"/>

            <TextBlock Text="Номер паспорта:" Margin="0,5"/>
            <TextBox x:Name="txtPassportNumber" MaxLength="6" Margin="0,5" Height="30"/>

            <TextBlock x:Name="lblError" Foreground="Red" Margin="0,10" TextAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                <Button x:Name="btnSave" Content="Добавить" Width="100" Height="35" Margin="5" Background="Green" Foreground="White"/>
                <Button x:Name="btnCancel" Content="Отмена" Width="100" Height="35" Margin="5"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>