<Window x:Class="HranitelProGeneralDept.RequestDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Проверка заявки" Height="750" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <ScrollViewer>
        <StackPanel Margin="15">
            <!-- Информация о заявке -->
            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="📋 Информация о заявке" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                    <TextBlock Text="Номер заявки:" FontWeight="Bold"/>
                    <TextBlock x:Name="lblRequestId" Margin="0,0,0,10"/>

                    <TextBlock Text="Тип:" FontWeight="Bold"/>
                    <TextBlock x:Name="lblRequestType" Margin="0,0,0,10"/>

                    <TextBlock Text="Статус:" FontWeight="Bold"/>
                    <TextBlock x:Name="lblStatus" Margin="0,0,0,10"/>

                    <!-- Причина отказа (видна только если статус "не одобрена") -->
                    <Border x:Name="borderRejectionReason" Background="#FFF0F0F0" BorderBrush="Red" BorderThickness="1" Padding="10" Margin="0,10,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="❌ Причина отказа:" FontWeight="Bold" Foreground="Red"/>
                            <TextBlock x:Name="lblRejectionReason" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Цель посещения:" FontWeight="Bold" Margin="0,10,0,0"/>
                    <TextBlock x:Name="lblPurpose" Margin="0,0,0,10"/>

                    <TextBlock Text="Подразделение:" FontWeight="Bold"/>
                    <TextBlock x:Name="lblDepartment" Margin="0,0,0,10"/>

                    <TextBlock Text="Принимающий сотрудник:" FontWeight="Bold"/>
                    <TextBlock x:Name="lblEmployee" Margin="0,0,0,10"/>

                    <TextBlock Text="Примечание:" FontWeight="Bold"/>
                    <TextBlock x:Name="lblNote" Margin="0,0,0,10" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Информация о посетителе -->
            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="👤 Информация о посетителе" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                    <TextBlock Text="ФИО:" FontWeight="Bold"/>
                    <TextBlock x:Name="lblVisitorFullName" Margin="0,0,0,10"/>

                    <TextBlock Text="Телефон:" FontWeight="Bold"/>
                    <TextBlock x:Name="lblVisitorPhone" Margin="0,0,0,10"/>

                    <TextBlock Text="Email:" FontWeight="Bold"/>
                    <TextBlock x:Name="lblVisitorEmail" Margin="0,0,0,10"/>

                    <TextBlock Text="Организация:" FontWeight="Bold"/>
                    <TextBlock x:Name="lblVisitorOrganization" Margin="0,0,0,10"/>

                    <TextBlock Text="Дата рождения:" FontWeight="Bold"/>
                    <TextBlock x:Name="lblVisitorBirthDate" Margin="0,0,0,10"/>

                    <TextBlock Text="Паспортные данные:" FontWeight="Bold"/>
                    <TextBlock x:Name="lblVisitorPassport" Margin="0,0,0,10"/>
                </StackPanel>
            </Border>

            <!-- Прикреплённые файлы -->
            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="📎 Прикреплённые файлы" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                    <ListBox x:Name="lstFiles" Height="100" Margin="0,5" SelectionMode="Single">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📄 " />
                                    <TextBlock Text="{Binding FileName}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button x:Name="btnOpenFile" Content="Открыть файл" Width="120" Height="30" HorizontalAlignment="Left" Margin="0,5"/>
                </StackPanel>
            </Border>

            <!-- Чёрный список -->
            <Border BorderBrush="Red" BorderThickness="1" Padding="10" Margin="0,0,0,10" Visibility="Collapsed" x:Name="borderBlackList">
                <TextBlock x:Name="lblBlackList" Foreground="Red" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
            </Border>

            <!-- Для одобрения (только если статус "проверка") -->
            <Border x:Name="borderApproval" BorderBrush="Green" BorderThickness="1" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="✅ Одобрение заявки" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                    <TextBlock Text="Дата посещения:" Margin="0,5"/>
                    <DatePicker x:Name="dpVisitDate" Width="150" Margin="0,5"/>

                    <TextBlock Text="Время посещения (ЧЧ:ММ):" Margin="0,5"/>
                    <TextBox x:Name="txtVisitTime" Width="100" Margin="0,5" Text="10:00"/>
                </StackPanel>
            </Border>

            <!-- Действия -->
            <StackPanel x:Name="panelActions" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10" Visibility="Collapsed">
                <Button x:Name="btnApprove" Content="Одобрить" Width="100" Height="35" Margin="5" Background="Green" Foreground="White"/>
                <Button x:Name="btnReject" Content="Отклонить" Width="100" Height="35" Margin="5" Background="Red" Foreground="White"/>
                <Button x:Name="btnClose" Content="Закрыть" Width="100" Height="35" Margin="5"/>
            </StackPanel>

            <Button x:Name="btnCloseOnly" Content="Закрыть" Width="100" Height="35" Margin="0,10" HorizontalAlignment="Center" Visibility="Collapsed"/>

            <TextBlock x:Name="lblMessage" Foreground="Blue" TextAlignment="Center" Margin="0,5" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Window>