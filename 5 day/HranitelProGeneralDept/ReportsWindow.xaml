<Window x:Class="HranitelProGeneralDept.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отчеты" Height="500" Width="800"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="tabControl" Grid.Row="0" Height="40">
            <TabItem Header="📊 Количество посещений" x:Name="tabVisits"/>
            <TabItem Header="👥 Список на территории" x:Name="tabCurrent"/>
        </TabControl>

        <!-- Вкладка "Количество посещений" -->
        <Grid Grid.Row="1" Visibility="Visible" x:Name="gridVisits">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="10" Grid.Row="0">
                <TextBlock Text="Период:" VerticalAlignment="Center" Margin="5,0"/>
                <ComboBox x:Name="cmbPeriod" Width="100" Margin="5">
                    <ComboBoxItem>день</ComboBoxItem>
                    <ComboBoxItem>месяц</ComboBoxItem>
                    <ComboBoxItem>год</ComboBoxItem>
                </ComboBox>

                <TextBlock Text="Подразделение:" VerticalAlignment="Center" Margin="5,0"/>
                <ComboBox x:Name="cmbDepartment" Width="150" Margin="5"/>

                <Button x:Name="btnShowReport" Content="Показать отчет" Width="120" Margin="20,0,0,0" Background="DarkBlue" Foreground="White"/>
                <Button x:Name="btnManualReport" Content="📁 Создать отчет за 3 часа" 
        Width="180" Margin="10" Background="DarkGreen" Foreground="White"/>
            </StackPanel>

            <DataGrid x:Name="dgvReport" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" Margin="10"/>
        </Grid>

        <!-- Вкладка "Список на территории" -->
        <Grid Grid.Row="1" Visibility="Collapsed" x:Name="gridCurrent">
            <DataGrid x:Name="dgvCurrent" AutoGenerateColumns="True" IsReadOnly="True" Margin="10"/>
        </Grid>
    </Grid>
</Window>