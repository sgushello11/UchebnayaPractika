<Window x:Class="HranitelProDivision.RequestDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Просмотр заявки" Height="680" Width="550"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer>
            <StackPanel Margin="15">
                <!-- Информация о заявке -->
                <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="📋 Информация о заявке" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                        <TextBlock Text="Номер заявки:" FontWeight="Bold"/>
                        <TextBlock x:Name="lblRequestId" Margin="0,0,0,10"/>

                        <TextBlock Text="Тип:" FontWeight="Bold"/>
                        <TextBlock x:Name="lblRequestType" Margin="0,0,0,10"/>

                        <TextBlock Text="Статус:" FontWeight="Bold"/>
                        <TextBlock x:Name="lblStatus" Margin="0,0,0,10"/>

                        <TextBlock Text="Цель:" FontWeight="Bold"/>
                        <TextBlock x:Name="lblPurpose" Margin="0,0,0,10"/>

                        <TextBlock Text="Подразделение:" FontWeight="Bold"/>
                        <TextBlock x:Name="lblDepartment" Margin="0,0,0,10"/>

                        <TextBlock Text="Примечание:" FontWeight="Bold"/>
                        <TextBlock x:Name="lblNote" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Информация о посетителе -->
                <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="👤 Информация о посетителе" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            <Button x:Name="btnAddToBlacklist" Content="🚫 Добавить в черный список" 
                                    Margin="20,0,0,0" Padding="8,3" Background="DarkRed" Foreground="White"
                                    Cursor="Hand" FontSize="11"/>
                        </StackPanel>

                        <TextBlock Text="ФИО:" FontWeight="Bold"/>
                        <TextBlock x:Name="lblVisitorFullName" Margin="0,0,0,10"/>

                        <TextBlock Text="Телефон:" FontWeight="Bold"/>
                        <TextBlock x:Name="lblVisitorPhone" Margin="0,0,0,10"/>

                        <TextBlock Text="Email:" FontWeight="Bold"/>
                        <TextBlock x:Name="lblVisitorEmail" Margin="0,0,0,10"/>

                        <TextBlock Text="Организация:" FontWeight="Bold"/>
                        <TextBlock x:Name="lblVisitorOrganization" Margin="0,0,0,10"/>

                        <TextBlock Text="Дата рождения:" FontWeight="Bold"/>
                        <TextBlock x:Name="lblVisitorBirthDate" Margin="0,0,0,10"/>

                        <TextBlock Text="Паспорт:" FontWeight="Bold"/>
                        <TextBlock x:Name="lblVisitorPassport" Margin="0,0,0,10"/>
                    </StackPanel>
                </Border>

                <!-- Время посещения -->
                <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="⏱️ Время посещения" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                        <TextBlock Text="Разрешение доступа (охрана):" FontWeight="Bold"/>
                        <TextBlock x:Name="lblEntryTime" Margin="0,0,0,10"/>

                        <TextBlock Text="Приход посетителя (подразделение):" FontWeight="Bold"/>
                        <TextBlock x:Name="lblDivisionEntryTime" Margin="0,0,0,10"/>

                        <TextBlock Text="Выход посетителя:" FontWeight="Bold"/>
                        <TextBlock x:Name="lblExitTime" Margin="0,0,0,10"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="lblMessage" Foreground="Green" TextAlignment="Center" Margin="0,10" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
            <Button x:Name="btnEntry" Content="🚪 Зафиксировать вход" Width="160" Height="35" Margin="5" Background="DarkGreen" Foreground="White" IsEnabled="False"/>
            <Button x:Name="btnExit" Content="⏱️ Зафиксировать выход" Width="160" Height="35" Margin="5" Background="DarkOrange" Foreground="White" IsEnabled="False"/>
            <Button x:Name="btnClose" Content="Закрыть" Width="100" Height="35" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>