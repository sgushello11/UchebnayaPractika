<Window x:Class="HranitelProSecurity.AccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Доступ" Height="604" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <StackPanel Margin="20">
        <TextBlock Text="📋 Информация о посетителе" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

        <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="ФИО:" FontWeight="Bold"/>
                <TextBlock x:Name="lblFullName" Margin="0,0,0,10"/>

                <TextBlock Text="Паспорт:" FontWeight="Bold"/>
                <TextBlock x:Name="lblPassport" Margin="0,0,0,10"/>

                <TextBlock Text="Телефон:" FontWeight="Bold"/>
                <TextBlock x:Name="lblPhone" Margin="0,0,0,10"/>

                <TextBlock Text="Подразделение:" FontWeight="Bold"/>
                <TextBlock x:Name="lblDepartment" Margin="0,0,0,10"/>

                <TextBlock Text="Тип заявки:" FontWeight="Bold"/>
                <TextBlock x:Name="lblType" Margin="0,0,0,10"/>

                <TextBlock Text="Цель:" FontWeight="Bold"/>
                <TextBlock x:Name="lblPurpose" Margin="0,0,0,10"/>

                <TextBlock Text="Дата посещения:" FontWeight="Bold"/>
                <TextBlock x:Name="lblDate" Margin="0,0,0,10"/>

                <TextBlock x:Name="lblTimeInfo" Margin="0,0,0,10" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <Button x:Name="btnAction" Height="50" Margin="0,10" FontSize="16" FontWeight="Bold"/>
        <Button x:Name="btnClose" Content="Закрыть" Height="35" Margin="0,5"/>

        <TextBlock x:Name="lblMessage" Foreground="Blue" TextAlignment="Center" Margin="0,10" TextWrapping="Wrap"/>
    </StackPanel>
</Window>