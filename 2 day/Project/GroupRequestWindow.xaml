<Window x:Class="HranitelPro.GroupRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Групповое посещение" Height="650" Width="550"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer>
        <StackPanel Margin="15">
            <!-- Информация для пропуска -->
            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="📋 Информация для пропуска" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Срок действия заявки:" VerticalAlignment="Center" Width="140"/>
                        <DatePicker x:Name="dpStartDate" Width="110"/>
                        <TextBlock Text="по" VerticalAlignment="Center" Margin="5,0,5,0"/>
                        <DatePicker x:Name="dpEndDate" Width="110"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Цель посещения:" Width="140" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtPurpose" Width="280" Height="25"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Принимающая сторона -->
            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="🏢 Принимающая сторона" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Подразделение*:" Width="140" VerticalAlignment="Center"/>
                        <ComboBox x:Name="cmbDepartment" Width="280" Height="25" DisplayMemberPath="department"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ФИО сотрудника*:" Width="140" VerticalAlignment="Center"/>
                        <ComboBox x:Name="cmbEmployee" Width="280" Height="25" DisplayMemberPath="fullname" SelectedValuePath="employeeid"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Информация о посетителе -->
            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="👤 Информация о посетителе" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Фамилия*:" Width="140" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtLastName" Width="280" Height="25"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Имя*:" Width="140" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtFirstName" Width="280" Height="25"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Отчество:" Width="140" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtPatronymic" Width="280" Height="25"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Телефон:" Width="140" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtPhone" Width="280" Height="25"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="E-mail*:" Width="140" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtEmail" Width="280" Height="25"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Организация:" Width="140" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtOrganization" Width="280" Height="25"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Примечание:" Width="140" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtNote" Width="280" Height="25"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Дата рождения*:" Width="140" VerticalAlignment="Center"/>
                        <DatePicker x:Name="dpBirthDate" Width="150"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Паспорт*:" Width="140" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtPassportSeries" Width="70" Height="25" MaxLength="4"/>
                        <TextBlock Text="-" Margin="2,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtPassportNumber" Width="90" Height="25" MaxLength="6"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Список посетителей (группа) -->
            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="👥 Список посетителей (группа не менее 5 человек)" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Button x:Name="btnDownloadTemplate" Content="📥 Скачать шаблон списка" Width="180" Height="30"/>
                        <Button x:Name="btnUploadList" Content="📂 Загрузить список (xlsx)" Width="180" Height="30" Margin="10,0,0,0"/>
                    </StackPanel>
                    <DataGrid x:Name="dgvGroupMembers" AutoGenerateColumns="True" Height="150" Margin="0,10,0,0"/>
                    <Button x:Name="btnAddVisitor" Content="➕ Добавить посетителя" Width="150" Height="30" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>

            <!-- Вставьте этот блок в GroupRequestWindow.xaml после списка посетителей -->

            <!-- Прикрепляемые документы -->
            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="📎 Прикрепляемые документы" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                    <!-- Скан паспорта организатора -->
                    <StackPanel Margin="0,0,0,5">
                        <Button x:Name="btnAttachPassport" Content="📄 Прикрепить скан паспорта (PDF)" Height="35"/>
                        <StackPanel x:Name="panelPassport" Orientation="Horizontal" Margin="10,5,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="lblPassportFile" VerticalAlignment="Center" Foreground="Blue"/>
                            <Button x:Name="btnRemovePassport" Content="❌ Удалить" Margin="10,0,0,0" Width="70" Height="25" Background="Red" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="lblStatus" Foreground="Green" TextAlignment="Center" Margin="0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnSubmit" Content="✅ Отправить заявку" Height="40" Width="150" Margin="5" Background="Green" Foreground="White"/>
                <Button x:Name="btnCancel" Content="❌ Отмена" Height="40" Width="100" Margin="5"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>