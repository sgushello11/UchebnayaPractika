<Window x:Class="HranitelPro.MyRequestsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мои заявки" Height="500" Width="800"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="dgvRequests" AutoGenerateColumns="True" IsReadOnly="True" Margin="10"/>

        <Button x:Name="btnBack" Grid.Row="1" Content="Назад" Height="35" Width="100" Margin="10" HorizontalAlignment="Right"/>
    </Grid>
</Window>