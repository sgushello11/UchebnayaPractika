<Window x:Class="HranitelPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ХранительПРО" Height="550" Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,10,0">
            <TextBlock x:Name="lblUser" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button x:Name="btnLogout" Content="Выйти" Background="Red" Foreground="White" Width="60"/>
        </StackPanel>

        <!-- Кнопки управления заявками -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
            <Button x:Name="btnAdd" Content="➕ Добавить заявку" Width="140" Margin="5" Background="Green" Foreground="White"/>
            <Button x:Name="btnEdit" Content="✏️ Редактировать" Width="140" Margin="5" Background="Orange" Foreground="White"/>
            <Button x:Name="btnDelete" Content="🗑️ Удалить" Width="120" Margin="5" Background="Red" Foreground="White"/>
            <Button x:Name="btnRefresh" Content="🔄 Обновить" Width="100" Margin="5"/>
        </StackPanel>

        <!-- Список заявок -->
        <DataGrid x:Name="dgvRequests" Grid.Row="2" AutoGenerateColumns="True" IsReadOnly="True" Margin="10" SelectionMode="Single" SelectionUnit="FullRow"/>
    </Grid>
</Window>